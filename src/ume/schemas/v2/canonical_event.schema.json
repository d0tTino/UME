{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UME Canonical Event",
  "type": "object",
  "properties": {
    "eventType": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "integer"
        }
      ]
    },
    "eventId": {
      "type": "string"
    },
    "correlationId": {
      "type": "string"
    },
    "subjectEntity": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      }
    },
    "sourceService": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "traceId": {
      "type": "string"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "eventType",
    "timestamp"
  ]
}
