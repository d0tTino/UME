# Runtime mode: development|staging|production
UME_ENV=production

# Required secrets for non-development deployments
UME_AUDIT_SIGNING_KEY=<replace-with-random-signing-key>
UME_API_TOKEN=<replace-with-random-api-token>
UME_OAUTH_PASSWORD=<replace-with-random-oauth-password>

# Optional file-backed secret variants (preferred in Docker/Kubernetes)
UME_AUDIT_SIGNING_KEY_FILE=
UME_API_TOKEN_FILE=
UME_OAUTH_PASSWORD_FILE=
NEO4J_PASSWORD_FILE=
KAFKA_SASL_PASSWORD_FILE=

# Neo4j connection
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<replace-with-neo4j-password>

# Kafka bootstrap and security
KAFKA_BOOTSTRAP_SERVERS=redpanda:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# TLS paths (required for SSL/SASL_SSL)
KAFKA_CA_CERT=
KAFKA_CLIENT_CERT=
KAFKA_CLIENT_KEY=
